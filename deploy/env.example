# ----------------------------------------------------------------------
# Production environment for the xneelo deployment.
#
# On the server, copy this to ".env" in the project root and fill in real
# values:   cp deploy/env.example .env
#
# The real .env file is git-ignored — never commit it.
# ----------------------------------------------------------------------

# Public URL of the live site. Include https://, no trailing slash.
PUBLIC_URL=https://your-domain.co.za

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=dg_property
POSTGRES_USER=dg_property
# Long random password — generate with:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_long_random_password

# --- Backend secrets ----------------------------------------------------
# Long random string — generate with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_long_random_secret

# Admin account seeded on first boot (and re-applied on every restart).
DEFAULT_ADMIN_EMAIL=admin@your-domain.co.za
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
